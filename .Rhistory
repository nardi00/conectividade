# Adicionar atributos dos nós
V(g)$to_idx   <- to_named[V(g)$name]
V(g)$net_idx  <- net_named[V(g)$name]
V(g)$controle <- meta_nos$controle[match(V(g)$name, meta_nos$nome)]
# Métricas de centralidade
V(g)$betweenness   <- betweenness(g, normalized = TRUE, weights = E(g)$weight)
V(g)$eigen_central <- eigen_centrality(g, weights = E(g)$weight)$vector
V(g)$pagerank      <- page_rank(g, weights = E(g)$weight)$vector
return(g)
}
# Recriar o grafo com a função corrigida
grafo_full <- constroi_grafo(
gfevd_mat = gfevd_matrix,
to_vec    = to_full,
net_vec   = net_full
)
# Verificar
cat("to_idx:", V(grafo_full)$to_idx, "\n")
cat("net_idx:", V(grafo_full)$net_idx, "\n")
# ── (a) Grafo full sample ─────────────────────────────────────────────────────
grafo_full <- constroi_grafo(
gfevd_mat = as.matrix(gfevd_matrix),
to_vec    = to_full,
net_vec   = net_full
)
# Layout Fruchterman-Reingold (fixado com set.seed no topo)
layout_fixo <- create_layout(as_tbl_graph(grafo_full), layout = "fr")
# Salvar coordenadas para reutilização nos subperíodos
coords_fixas <- layout_fixo[, c("x", "y", "name")]
# Gráfico
p_grafo_full <- ggraph(layout_fixo) +
geom_edge_arc(
aes(width = weight, alpha = weight),
color      = "grey50",
arrow      = arrow(length = unit(3, "mm"), type = "closed"),
end_cap    = circle(4, "mm"),
strength   = 0.2
) +
geom_node_point(
aes(size  = to_idx,
color = net_idx,
shape = controle),
show.legend = TRUE
) +
geom_node_text(
aes(label = name),
size    = 3.2,
fontface = "bold",
repel   = TRUE,
vjust   = -1.2
) +
scale_color_gradient2(
low      = "#4393c3",
mid      = "white",
high     = "#d6604d",
midpoint = 0,
name     = "NET (%)"
) +
scale_size_continuous(name = "TO (%)", range = c(4, 14)) +
scale_edge_width_continuous(range = c(0.3, 2.5), guide = "none") +
scale_edge_alpha_continuous(range = c(0.2, 0.8), guide = "none") +
scale_shape_manual(
name   = "Controle",
values = c("Privado Nacional"    = 16,
"Privado Estrangeiro" = 17,
"Público Federal"     = 15,
"Público Estadual"    = 18)
) +
labs(
title    = "Rede de Spillovers de Volatilidade — Sistema Bancário Brasileiro",
subtitle = paste0("Full sample (2014–2025) | VAR(", P_LAGS, ") | GFEVD H=",
H_HORIZONTE, " | Threshold: ", THRESHOLD*100, "%"),
caption  = "Tamanho do nó ∝ TO; Cor ∝ NET (vermelho = transmissor, azul = receptor)"
) +
theme_graph(base_size = 11) +
theme(
plot.title    = element_text(face = "bold", size = 12),
plot.subtitle = element_text(size = 9),
legend.position = "right"
)
ggsave("outputs/graficos/grafo_fullsample.png", p_grafo_full,
width = 12, height = 9, dpi = 300)
cat("  Grafo full sample salvo.\n")
# ── Exportar métricas de centralidade ─────────────────────────────────────────
centralidade_df <- data.frame(
Banco         = V(grafo_full)$name,
TO            = round(V(grafo_full)$to_idx,        2),
NET           = round(V(grafo_full)$net_idx,       2),
Betweenness   = round(V(grafo_full)$betweenness,   4),
EigenCentral  = round(V(grafo_full)$eigen_central, 4),
PageRank      = round(V(grafo_full)$pagerank,      6)
)
centralidade_df <- centralidade_df[order(-centralidade_df$PageRank), ]
rownames(centralidade_df) <- NULL
cat("\n  Ranking de centralidade (full sample):\n")
print(centralidade_df)
write.csv(centralidade_df, "outputs/tabelas/centralidade_fullsample.csv",
row.names = FALSE)
# ── (b) Painéis por subperíodo ────────────────────────────────────────────────
# Define subperíodos de interesse (para o grafo comparativo)
subperiodos <- list(
"Pre-COVID (2014-2019)"     = c("2014-01-01", "2019-12-31"),
"COVID-19 (2020)"           = c("2020-01-01", "2020-12-31"),
"Aperto Selic (2022)"       = c("2022-01-01", "2022-12-31"),
"Americanas (Jan-Mar 2023)" = c("2023-01-01", "2023-03-31")
)
grafos_sub <- list()
for (periodo in names(subperiodos)) {
datas_sub <- subperiodos[[periodo]]
Y_sub <- Y[index(painel_imp) >= as.Date(datas_sub[1]) &
index(painel_imp) <= as.Date(datas_sub[2]), ]
if (nrow(Y_sub) < N_JANELA_W) {
cat("  Subperíodo '", periodo, "' tem menos de", N_JANELA_W,
"obs. Usando full sample do subperíodo.\n")
}
dca_sub <- tryCatch(
suppressMessages(
ConnectednessApproach(
zoo(as.matrix(Y_sub), order.by = index(Y_sub)),
nlag     = P_LAGS,
nfore    = H_HORIZONTE,
window   = NULL,
corrected = FALSE,
model    = "VAR"
)
),
error = function(e) {
warning("Falha no subperíodo '", periodo, "': ", e$message)
NULL
}
)
if (is.null(dca_sub)) next
g_sub <- constroi_grafo(
gfevd_mat = as.matrix(dca_sub$TABLE),
to_vec    = dca_sub$TO,
net_vec   = dca_sub$NET
)
# Aplicar layout fixo do full sample
tbl_sub <- as_tbl_graph(g_sub)
layout_sub <- create_layout(tbl_sub, layout = "manual",
x = coords_fixas$x[match(V(g_sub)$name, coords_fixas$name)],
y = coords_fixas$y[match(V(g_sub)$name, coords_fixas$name)])
p_sub <- ggraph(layout_sub) +
geom_edge_arc(
aes(width = weight, alpha = weight),
color    = "grey50",
arrow    = arrow(length = unit(2.5, "mm"), type = "closed"),
end_cap  = circle(3.5, "mm"),
strength = 0.2
) +
geom_node_point(
aes(size = to_idx, color = net_idx, shape = controle)
) +
geom_node_text(aes(label = name), size = 3, fontface = "bold",
repel = TRUE, vjust = -1.2) +
scale_color_gradient2(low = "#4393c3", mid = "white", high = "#d6604d",
midpoint = 0, name = "NET (%)", limits = c(-30, 30)) +
scale_size_continuous(range = c(3, 12), guide = "none") +
scale_edge_width_continuous(range = c(0.2, 2), guide = "none") +
scale_edge_alpha_continuous(range = c(0.15, 0.7), guide = "none") +
scale_shape_manual(values = c("Privado Nacional" = 16, "Privado Estrangeiro" = 17,
"Público Federal" = 15, "Público Estadual" = 18),
guide = "none") +
labs(title = periodo,
subtitle = paste0("TCI = ", round(dca_sub$TCI, 1), "%")) +
theme_graph(base_size = 9) +
theme(plot.title = element_text(face = "bold", size = 9),
legend.position = "none")
grafos_sub[[periodo]] <- p_sub
}
knitr::opts_chunk$set(
echo    = TRUE,
warning = FALSE,
message = FALSE,
cache   = FALSE
)
dados_brutos <- list()
for (ticker in TICKERS) {
nome <- sub("\\.SA$", "", ticker)
cat("Baixando", ticker, "...\n")
tryCatch({
dados_brutos[[nome]] <- getSymbols(
ticker, src = "yahoo",
from = DATA_INICIO, to = DATA_FIM,
auto.assign = FALSE, return.class = "xts"
)
Sys.sleep(0.5)
}, error = function(e) warning("Falha ao baixar ", ticker, ": ", e$message))
}
# Verificação
faltando <- setdiff(NOMES, names(dados_brutos))
if (length(faltando) > 0)
stop("Tickers não baixados: ", paste(faltando, collapse = ", "))
# Resumo
resumo <- do.call(rbind, lapply(NOMES, function(nome) {
d <- dados_brutos[[nome]]
data.frame(
Banco = nome,
Obs   = nrow(d),
De    = as.character(index(d)[1]),
Ate   = as.character(index(d)[nrow(d)]),
NAs   = sum(is.na(d))
)
}))
knitr::kable(resumo, caption = "Resumo das séries coletadas")
dados_adj <- list()
for (nome in NOMES) {
raw <- dados_brutos[[nome]]
op  <- as.numeric(Op(raw))
hi  <- as.numeric(Hi(raw))
lo  <- as.numeric(Lo(raw))
cl  <- as.numeric(Cl(raw))
vol <- as.numeric(Vo(raw))
adj <- as.numeric(Ad(raw))
dts <- index(raw)
phi <- adj / cl
phi[is.na(phi) | is.infinite(phi)] <- 1
dados_adj[[nome]] <- xts(
data.frame(Open = op*phi, High = hi*phi, Low = lo*phi,
Close = adj, Volume = vol),
order.by = dts
)
}
cat("Ajuste por proventos aplicado a", length(dados_adj), "séries.\n")
d      <- dados_brutos[["ABCB4"]]
janela <- d["2015-12-28/2016-01-08"]
knitr::kable(
data.frame(
Data     = as.character(index(janela)),
Close    = round(as.numeric(Cl(janela)), 4),
Adjusted = round(as.numeric(Ad(janela)), 4),
phi      = round(as.numeric(Ad(janela)) / as.numeric(Cl(janela)), 6)
),
caption = "Fator de ajuste ABCB4 — jan/2016"
)
q()

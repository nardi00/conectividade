# ── Constantes globais ────────────────────────────────────────────────────
CAMINHO_EXCEL <- "Cotacoes_ComDinheiro_8bancos_2014-2026.xlsx"
NOMES <- c("ITUB4", "BBDC4", "BBAS3", "SANB11",
"BPAC11", "BRSR6", "ABCB4", "BPAN4")
DATA_INICIO <- "2019-01-01"
DATA_FIM    <- "2025-12-31"
N_JANELA_W    <- 200
